# Local dev DB runs via docker-compose (postgres service), published on host
# port 5433 (5432 is taken by a pre-existing native PostgreSQL service on this
# machine). Replace user/password/dbname with the same values you set below.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/dbname
SECRET_KEY=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# pytest test suite: same PostgreSQL instance/user/password as above, but a
# separate database (create it once with `CREATE DATABASE timetable_test;`
# in the running postgres container) so tests never touch dev data. Must be
# a DIFFERENT database name than DATABASE_URL above -- conftest.py refuses
# to run if the two are identical, since the test suite calls
# Base.metadata.drop_all() against it.
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/timetable_test
